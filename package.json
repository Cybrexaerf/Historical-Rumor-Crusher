{
  "name": "history-rumor-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-content.mts && vite build && node scripts/check-offline.mts",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:build": "node scripts/build-content.mjs",
    "content:new": "node scripts/new-entry.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.2.8",
    "dompurify": "^3.4.14",
    "idb": "^8.0.3",
    "js-yaml": "^5.3.0",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "minisearch": "^7.2.0",
    "pinyin-pro": "^3.29.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "8.57",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
